# ===================================================================
# Legal Bot — Configuración de Entorno
# Copiá este archivo como .env y completá tus valores
# ===================================================================

# ─── Core ───────────────────────────────────────────────────────────
GEMINI_API_KEY=tu_api_key_aqui
OUTPUT_DIR=output
DB_PATH=db.sqlite
PORT=5000

# ─── WhatsApp ────────────────────────────────────────────────────────
# Número en formato internacional sin + (ej: 5491112345678)
WHATSAPP_PHONE=5491100000000

# ─── Publicación Automática ──────────────────────────────────────────
# URL pública del servidor (necesaria para subir imágenes a APIs de redes)
# Podés usar ngrok: ngrok http 5000  → https://xxxx.ngrok.io
PUBLIC_BASE_URL=

# ─── Instagram / Meta Graph API ─────────────────────────────────────
# Obtené tus credenciales en: https://developers.facebook.com/
# Necesitás una cuenta de Instagram Business y una Meta App
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── TikTok for Business API ────────────────────────────────────────
# Obtené tus credenciales en: https://developers.tiktok.com/
# Necesitás una cuenta TikTok for Business y una app aprobada
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ─── Facebook Pages API ─────────────────────────────────────────────
# Obtené tus credenciales en: https://developers.facebook.com/ (Meta for Developers)
# 1. Creá una Meta App de tipo "Negocios" / "Business".
# 2. Generá un Page Access Token con los permisos:
#    - pages_manage_posts
#    - pages_read_engagement
#    - pages_show_list
# 3. El FACEBOOK_PAGE_ID lo encontrás en la sección "Información" de tu Fanpage de Facebook.
# Podés publicar directamente sin ngrok gracias a la subida binaria multipart.
# Si dejás estos valores vacíos, el sistema activa automáticamente el modo
# semi-automático guiado en 5 pasos (descarga de imagen 1:1 y copia de texto).
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
